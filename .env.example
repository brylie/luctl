# luctl S3 backup credentials
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY — read before setting values:
#
#   DO NOT export these variables directly in your shell. Typing
#
#       export LUCTL_S3_ACCESS_KEY=mykey      ← appears in shell history
#
#   stores the secret in plain text in ~/.bash_history or ~/.zsh_history.
#
# SAFE option 1 — source a file (recommended):
#
#       cp .env.example .env
#       chmod 600 .env          # owner read/write only
#       $EDITOR .env            # fill in your values
#       source .env             # only "source .env" is recorded in history
#
# SAFE option 2 — read interactively (no file needed):
#
#       read -rs LUCTL_S3_ACCESS_KEY && export LUCTL_S3_ACCESS_KEY
#       read -rs LUCTL_S3_SECRET_KEY && export LUCTL_S3_SECRET_KEY
#
#   (-r disables backslash interpretation; -s suppresses echo)
#
# SAFE option 3 — direnv (auto-loads when you cd into the directory):
#
#       echo 'source_env .env' >> .envrc
#       direnv allow
#
# ─────────────────────────────────────────────────────────────────────────────
# Never commit .env to version control. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

LUCTL_S3_ACCESS_KEY=
LUCTL_S3_SECRET_KEY=
